{
  "name": "@sebastienrousseau/jsdoc-config",
  "version": "0.0.7",
  "description": "Shareable JSDoc documentation generator configuration files and rules",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/jsdoc-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/jsdoc-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/jsdoc-config/issues"
  },
  "keywords": [
    "jsdoc",
    "jsdocrc",
    "documentation",
    "jsdoc-template"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "jsdoc-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/conformance.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh",
    "test:conformance": "node --test tests/conformance.test.js",
    "fuzz": "node fuzz/fuzz_config.js",
    "validate": "node scripts/validate.mjs"
  },
  "peerDependencies": {
    "jsdoc": ">=4.0.0"
  },
  "devDependencies": {
    "@sebastienrousseau/config-kit": "^0.0.8",
    "jsdoc": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "configKit": {
    "shape": "object",
    "presets": [],
    "nativeToolchain": "jsdoc"
  }
}
