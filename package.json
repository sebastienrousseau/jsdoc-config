  },
  "scripts": {
    "test": "node test/test.js",
    "lint": "node test/test.js"
  },
  "peerDependencies": {
    "jsdoc": ">=4.0.0"
  },
  "devDependencies": {
    "jsdoc": "^4.0.0"
  }
}
